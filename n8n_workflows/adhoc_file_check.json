{
  "name": "Ad-Hoc File Check (Manual Trigger)",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "partner",
              "value": "={{ $json.partner || 'PARTNER_A' }}"
            },
            {
              "name": "report_type",
              "value": "={{ $json.report_type || 'CIC_REPORT' }}"
            },
            {
              "name": "sftp_path",
              "value": "={{ $json.sftp_path || '/sftp/cub/cic_reports/' }}"
            },
            {
              "name": "current_time",
              "value": "={{ $now.toFormat('HH:mm') }}"
            },
            {
              "name": "current_date",
              "value": "={{ $now.toFormat('yyyyMMdd') }}"
            }
          ]
        }
      },
      "id": "set-variables",
      "name": "Set Variables",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "channel": "#42cards-data-ops",
        "text": "=📊 *Ad-Hoc File Check Complete*\n\nPartner: {{ $json.partner }}\nReport: {{ $json.report_type }}\nStatus: {{ $json.status }}\nValidation: {{ $json.validation }}",
        "otherOptions": {}
      },
      "id": "slack-results",
      "name": "Slack Results",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.1,
      "position": [650, 300],
      "credentials": {
        "slackApi": {
          "id": "1",
          "name": "Slack API"
        }
      }
    }
  ],
  "connections": {
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Set Variables",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Set Variables": {
      "main": [
        [
          {
            "node": "Slack Results",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
