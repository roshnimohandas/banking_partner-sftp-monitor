{
  "partners": [
    {
      "id": "PARTNER_A",
      "name": "Banking Partner A",
      "description": "Banking Partner A file processing",
      "sftp": {
        "host": "sftp.partner-a.example.com",
        "port": 22,
        "username": "partner_a_user",
        "remote_paths": [
          "/incoming/transactions",
          "/incoming/settlements",
          "/incoming/reports"
        ]
      },
      "file_patterns": {
        "transaction": "PARTNER_A_YYYYMMDD_HHMMSS_TRANSACTION.csv",
        "settlement": "PARTNER_A_YYYYMMDD_HHMMSS_SETTLEMENT.csv",
        "report": "PARTNER_A_YYYYMMDD_HHMMSS_REPORT.csv"
      },
      "validation": {
        "regex": "^PARTNER_A_\\d{8}_\\d{6}_(TRANSACTION|SETTLEMENT|REPORT)\\.csv$",
        "min_size_bytes": 100,
        "max_size_bytes": 104857600,
        "max_age_hours": 24,
        "expected_extensions": [".csv"]
      },
      "schedule": {
        "check_interval_minutes": 15,
        "expected_files": [
          {
            "name": "TRANSACTION",
            "frequency": "daily",
            "expected_time": "09:00"
          },
          {
            "name": "SETTLEMENT",
            "frequency": "daily",
            "expected_time": "18:00"
          },
          {
            "name": "REPORT",
            "frequency": "weekly",
            "expected_time": "10:00",
            "expected_day": "Monday"
          }
        ]
      },
      "alerts": {
        "slack_channel": "#partner-a-alerts",
        "email_recipients": ["admin@company.com", "finance@company.com"],
        "webhook_url": "https://hooks.example.com/partner-a"
      }
    },
    {
      "id": "PARTNER_B",
      "name": "Banking Partner B",
      "description": "Banking Partner B file processing",
      "sftp": {
        "host": "sftp.partner-b.example.com",
        "port": 22,
        "username": "partner_b_user",
        "remote_paths": [
          "/data/incoming"
        ]
      },
      "file_patterns": {
        "transaction": "PARTNER_B_YYYYMMDD_HHMMSS_TXN.csv",
        "settlement": "PARTNER_B_YYYYMMDD_HHMMSS_SETTLE.csv",
        "report": "PARTNER_B_YYYYMMDD_HHMMSS_RPT.csv"
      },
      "validation": {
        "regex": "^PARTNER_B_\\d{8}_\\d{6}_(TXN|SETTLE|RPT)\\.csv$",
        "min_size_bytes": 100,
        "max_size_bytes": 104857600,
        "max_age_hours": 24,
        "expected_extensions": [".csv"]
      },
      "schedule": {
        "check_interval_minutes": 15,
        "expected_files": [
          {
            "name": "TXN",
            "frequency": "daily",
            "expected_time": "08:30"
          },
          {
            "name": "SETTLE",
            "frequency": "daily",
            "expected_time": "17:30"
          },
          {
            "name": "RPT",
            "frequency": "daily",
            "expected_time": "19:00"
          }
        ]
      },
      "alerts": {
        "slack_channel": "#partner-b-alerts",
        "email_recipients": ["admin@company.com", "finance@company.com"],
        "webhook_url": "https://hooks.example.com/partner-b"
      }
    }
  ],
  "global_settings": {
    "retry_attempts": 3,
    "retry_delay_seconds": 60,
    "download_directory": "./downloads",
    "archive_directory": "./archive",
    "log_level": "INFO",
    "enable_email_alerts": true,
    "enable_slack_alerts": true,
    "enable_webhook_alerts": true
  }
}
